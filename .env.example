# Graby — environment variables
# Copy this file to .env and fill in the values.

# PostgreSQL connection string (used by API and worker)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/graby

# OpenRouter credentials and model routing (used by the worker)
OPENROUTER_API_KEY=
# Use the lowest-cost paid model first ($0.01/M input, $0.03/M output).
OPENROUTER_MODEL=inclusionai/ling-2.6-flash
# Optional comma-separated fallbacks, tried in order when the primary fails.
OPENROUTER_FALLBACK_MODELS=mistralai/mistral-nemo,inclusionai/ling-3.0-flash,google/gemini-2.5-flash-lite,cohere/north-mini-code:free,liquid/lfm-2.5-2.6b:free

# Frontend public API URL (must be reachable from the user's browser)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional override for the Coto Digital search key. If empty, the worker
# discovers the current key from Coto's public frontend bundle.
COTO_SEARCH_API_KEY=

# Optional explicit WebSocket URL for worker events
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Allowed browser origins, comma-separated. In production use:
# CORS_ORIGINS=https://heygraby.com,https://www.heygraby.com
CORS_ORIGINS=http://localhost:3000
