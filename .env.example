# Graby — environment variables
# Copy this file to .env and fill in the values.

# URL of the Redis instance (used by backend and worker)
REDIS_URL=redis://localhost:6379

# URL of the Ollama instance (used by the worker for AI product selection)
# If running locally: http://localhost:11434
# If running inside Docker alongside host Ollama: http://host.docker.internal:11434
OLLAMA_HOST=http://localhost:11434

# Ollama model name to use for shopping list generation
OLLAMA_MODEL=llama3.2

# Frontend public API URL (must be reachable from the user's browser)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional explicit WebSocket URL for live worker events
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# noVNC URL for live browser view (worker container)
NEXT_PUBLIC_MONITOR_URL=http://localhost:6080/vnc.html?autoconnect=true&resize=scale&view_only=true
